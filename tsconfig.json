{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["vite/client", "node"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*"
  ]
}
